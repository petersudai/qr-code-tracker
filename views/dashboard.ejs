<%- include('partials/head', { title: 'Dashboard' }) %>
<%
  function fmtDate(d){ return d ? new Date(d).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) : '-'; }
  function fmtAgo(d){
    if(!d) return 'No scans yet';
    const s = Math.floor((Date.now()-new Date(d))/1000);
    if(s<60) return 'just now';
    if(s<3600) return Math.floor(s/60)+'m ago';
    if(s<86400) return Math.floor(s/3600)+'h ago';
    return Math.floor(s/86400)+'d ago';
  }
%>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<%- include('partials/nav') %>

<main id="main" tabindex="-1" class="max-w-6xl mx-auto px-5 sm:px-6 py-10">
  <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-bold text-white">Dashboard</h1>
      <p class="text-slate-400 mt-1">Every scan across all your campaigns.</p>
    </div>
    <a href="/#generate" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl font-semibold text-[#0a0a0a] bg-brand-400 hover:bg-brand-300 transition">
      <i data-lucide="plus" class="w-4 h-4"></i> New QR code
    </a>
  </div>

  <% if (stats.total === 0 && campaigns.length === 0) { %>
    <div class="rounded-3xl bg-[#131316] ring-1 ring-white/10 p-12 text-center">
      <h2 class="text-xl font-bold text-white">No campaigns yet</h2>
      <p class="text-slate-400 mt-2 max-w-sm mx-auto">Make your first QR code and its scans will appear here.</p>
      <a href="/#generate" class="inline-flex items-center mt-6 px-5 py-3 rounded-xl font-semibold text-[#0a0a0a] bg-brand-400 hover:bg-brand-300 transition">
        Create a QR code
      </a>
    </div>
  <% } else { %>

  <!-- Stat cards -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <% const cards = [
      ['Total scans', stats.total.toLocaleString(), true],
      ['Campaigns', campaigns.length.toLocaleString(), true],
      ['Top location', stats.topCity || stats.topCountry || '-', false],
      ['Last scan', fmtAgo(stats.lastScan), false]
    ]; %>
    <% cards.forEach(function(c){ %>
    <div class="rounded-2xl bg-[#131316] ring-1 ring-white/10 p-5">
      <p class="text-sm text-slate-400"><%= c[0] %></p>
      <p class="text-2xl font-semibold text-white mt-2 truncate <%= c[2] ? 'font-mono' : '' %>" title="<%= c[1] %>"><%= c[1] %></p>
    </div>
    <% }); %>
  </div>

  <!-- Chart + map -->
  <div class="grid lg:grid-cols-5 gap-5 mt-5">
    <div class="min-w-0 lg:col-span-3 rounded-2xl bg-[#131316] ring-1 ring-white/10 p-5 sm:p-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-semibold text-white">Scans · last 14 days</h2>
        <span class="text-xs text-slate-500">Daily</span>
      </div>
      <div class="relative h-64">
        <canvas id="timelineChart" role="img" aria-label="Line chart of scans per day over the last 14 days"></canvas>
      </div>
    </div>
    <div class="min-w-0 lg:col-span-2 rounded-2xl bg-[#131316] ring-1 ring-white/10 p-5 sm:p-6">
      <h2 class="font-semibold text-white mb-4">Where scans happen</h2>
      <% if (stats.points.length) { %>
        <div id="map" class="h-64 rounded-xl" role="region" aria-label="Map of scan locations"></div>
      <% } else { %>
        <div class="h-64 grid place-items-center text-center text-sm text-slate-500 rounded-xl bg-[#0f0f11] ring-1 ring-white/5">
          <div>No scans with a known location yet.<br>Some networks, mobile carriers especially, can't be placed on a map.</div>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Scans by placement -->
  <div class="mt-5 rounded-2xl bg-[#131316] ring-1 ring-white/10 p-5 sm:p-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-semibold text-white">Scans by placement</h2>
      <span class="text-xs text-slate-500">Most scanned first</span>
    </div>
    <% if (placements.length) { %>
      <%- include('partials/placements', { rows: placements, total: stats.total }) %>
    <% } else { %>
      <p class="text-sm text-slate-400 py-2">No scans yet. Each placement you print will be ranked here once people start scanning it.</p>
    <% } %>
  </div>

  <!-- Breakdown -->
  <div class="grid lg:grid-cols-3 gap-5 mt-5">
    <%- include('partials/breakdown', { title: 'Top countries', icon: 'globe', rows: stats.countries.slice(0,5), total: stats.total }) %>
    <%- include('partials/breakdown', { title: 'Devices', icon: 'smartphone', rows: stats.devices.slice(0,5), total: stats.total }) %>
    <%- include('partials/breakdown', { title: 'Browsers', icon: 'compass', rows: stats.browsers.slice(0,5), total: stats.total }) %>
  </div>

  <!-- Campaigns table -->
  <div class="mt-5 rounded-2xl bg-[#131316] ring-1 ring-white/10 overflow-hidden">
    <div class="flex items-center justify-between p-5 sm:p-6 border-b border-white/10">
      <h2 class="font-semibold text-white">Campaigns</h2>
      <span class="text-xs text-slate-500"><%= campaigns.length %> total</span>
    </div>
    <div class="overflow-x-auto relative">
      <table class="w-full text-sm">
        <thead class="text-left text-slate-500">
          <tr class="border-b border-white/5">
            <th scope="col" class="px-5 sm:px-6 py-3 font-medium">Campaign</th>
            <th scope="col" class="px-4 py-3 font-medium">Target</th>
            <th scope="col" class="px-4 py-3 font-medium text-right">Scans</th>
            <th scope="col" class="px-4 py-3 font-medium">Last scan</th>
            <th scope="col" class="px-4 py-3 font-medium">Created</th>
            <th scope="col" class="px-5 sm:px-6 py-3"><span class="sr-only">Open</span></th>
          </tr>
        </thead>
        <tbody>
          <% campaigns.forEach(function(c){ %>
          <tr class="border-b border-white/5 last:border-0 hover:bg-white/[0.03] transition">
            <td class="px-5 sm:px-6 py-3.5">
              <a href="/c/<%= c.slug %>" class="font-medium text-white hover:underline underline-offset-4 transition"><%= c.name %></a>
            </td>
            <td class="px-4 py-3.5 text-slate-400 max-w-[200px] truncate"><%= c.targetUrl %></td>
            <td class="px-4 py-3.5 text-right font-mono font-medium text-white tabular-nums"><%= c.scanCount %></td>
            <td class="px-4 py-3.5 font-mono text-xs text-slate-400 whitespace-nowrap"><%= fmtAgo(c.lastScan) %></td>
            <td class="px-4 py-3.5 font-mono text-xs text-slate-400 whitespace-nowrap"><%= fmtDate(c.createdAt) %></td>
            <td class="px-5 sm:px-6 py-3.5 text-right">
              <a href="/c/<%= c.slug %>" class="inline-flex items-center text-slate-500 hover:text-white" aria-label="Open <%= c.name %>"><i data-lucide="arrow-right" class="w-4 h-4"></i></a>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <% } %>
</main>

<%- include('partials/footer') %>
<% if (stats.total > 0) { %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
  window.ZIP = {
    timeline: <%- JSON.stringify(stats.timeline) %>,
    points: <%- JSON.stringify(stats.points) %>
  };
</script>
<script src="/js/charts.js"></script>
<% } %>
</body>
</html>
