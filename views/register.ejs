<%- include('partials/head', { title: 'Create your account' }) %>
<%- include('partials/nav') %>

<main id="main" tabindex="-1" class="max-w-md mx-auto px-5 sm:px-6 py-16">
  <div class="reveal rounded-3xl bg-[#131316] ring-1 ring-white/10 shadow-card p-7 sm:p-9">
    <h1 class="text-2xl font-bold text-white">Create your account</h1>
    <p class="text-slate-400 mt-1.5 text-sm">Your QR codes and their scans live in your account.</p>

    <% if (error) { %>
    <div role="alert" class="mt-5 flex items-start gap-2 rounded-xl bg-amber-500/10 ring-1 ring-amber-500/30 px-4 py-3 text-sm text-amber-300">
      <i data-lucide="alert-triangle" class="w-4 h-4 mt-0.5 shrink-0"></i> <%= error %>
    </div>
    <% } %>

    <form action="/register" method="POST" class="mt-6 space-y-4">
      <div>
        <label for="name" class="block mb-1.5 text-sm font-medium text-slate-300">Name</label>
        <input id="name" name="name" type="text" autocomplete="name" required maxlength="80" value="<%= values.name || '' %>"
          placeholder="Jane Doe"
          class="w-full px-4 py-3 rounded-xl bg-[#0f0f11] text-white placeholder-slate-400 ring-1 ring-[#64748b] focus:ring-2 focus:ring-brand-400 outline-none transition" />
      </div>
      <div>
        <label for="email" class="block mb-1.5 text-sm font-medium text-slate-300">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required value="<%= values.email || '' %>"
          placeholder="you@example.com"
          class="w-full px-4 py-3 rounded-xl bg-[#0f0f11] text-white placeholder-slate-400 ring-1 ring-[#64748b] focus:ring-2 focus:ring-brand-400 outline-none transition" />
      </div>
      <div>
        <label for="password" class="block mb-1.5 text-sm font-medium text-slate-300">Password</label>
        <input id="password" name="password" type="password" autocomplete="new-password" required minlength="8"
          placeholder="At least 8 characters"
          class="w-full px-4 py-3 rounded-xl bg-[#0f0f11] text-white placeholder-slate-400 ring-1 ring-[#64748b] focus:ring-2 focus:ring-brand-400 outline-none transition" />
      </div>
      <button type="submit"
        class="w-full inline-flex items-center justify-center px-5 py-3.5 rounded-xl font-semibold text-[#0a0a0a] bg-brand-400 hover:bg-brand-300 transition">
        Create account
      </button>
    </form>

    <p class="mt-6 text-center text-sm text-slate-400">
      Already have an account? <a href="/login" class="text-white font-medium underline underline-offset-4 decoration-white/30 hover:decoration-white transition">Log in</a>
    </p>
  </div>
</main>

<%- include('partials/footer') %>
</body>
</html>
