<%- include('partials/head', { title: 'Trackable QR codes' }) %>
<%- include('partials/nav') %>

<main>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-5 sm:px-6 pt-16 pb-12 sm:pt-24 sm:pb-16 grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <span class="reveal inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium text-brand-300 bg-brand-500/10 ring-1 ring-brand-500/20 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-400 animate-pulse"></span>
          No app required · works on every phone
        </span>
        <h1 class="reveal reveal-2 text-4xl sm:text-6xl font-bold tracking-tight leading-[1.05] text-gradient">
          Know exactly where your QR codes get scanned.
        </h1>
        <p class="reveal reveal-3 mt-6 text-lg text-slate-400 max-w-xl">
          Generate a QR code, put it up anywhere, and ZipLock logs every scan:
          city, device and time. Now your offline campaigns have real numbers behind them.
        </p>
        <div class="reveal reveal-4 mt-8 flex flex-wrap items-center gap-3">
          <a href="#generate" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-semibold text-[#0a0a0a] bg-brand-400 hover:bg-brand-300 shadow-glow transition">
            <i data-lucide="qr-code" class="w-5 h-5"></i> Generate a code
          </a>
          <% if (user) { %>
          <a href="/dashboard" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-semibold text-slate-200 bg-[#131316] ring-1 ring-white/10 hover:bg-[#1c1c20] transition">
            <i data-lucide="bar-chart-3" class="w-5 h-5"></i> View dashboard
          </a>
          <% } else { %>
          <a href="/register" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-semibold text-slate-200 bg-[#131316] ring-1 ring-white/10 hover:bg-[#1c1c20] transition">
            <i data-lucide="sparkles" class="w-5 h-5"></i> Sign up free
          </a>
          <% } %>
        </div>
        <div class="reveal reveal-4 mt-10 flex items-center gap-6 text-sm text-slate-500">
          <div class="flex items-center gap-2"><i data-lucide="map-pin" class="w-4 h-4 text-brand-400"></i> City-level location</div>
          <div class="flex items-center gap-2"><i data-lucide="smartphone" class="w-4 h-4 text-brand-400"></i> Device &amp; browser</div>
          <div class="flex items-center gap-2"><i data-lucide="clock" class="w-4 h-4 text-brand-400"></i> Real-time log</div>
        </div>
      </div>

      <!-- Floating QR preview card -->
      <div class="reveal reveal-3 relative lg:justify-self-end">
        <div class="float relative w-full max-w-sm mx-auto">
          <div class="absolute -inset-4 bg-brand-500/20 blur-3xl rounded-full"></div>
          <div class="relative rounded-3xl bg-[#131316] ring-1 ring-white/10 p-6 shadow-card">
            <div class="qr-frame mx-auto w-44 h-44 grid place-items-center">
              <svg viewBox="0 0 100 100" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
                <rect width="100" height="100" fill="#fff"/>
                <g fill="#111113">
                  <rect x="8" y="8" width="22" height="22"/><rect x="14" y="14" width="10" height="10" fill="#fff"/>
                  <rect x="70" y="8" width="22" height="22"/><rect x="76" y="14" width="10" height="10" fill="#fff"/>
                  <rect x="8" y="70" width="22" height="22"/><rect x="14" y="76" width="10" height="10" fill="#fff"/>
                  <rect x="40" y="10" width="6" height="6"/><rect x="50" y="10" width="6" height="6"/>
                  <rect x="40" y="22" width="6" height="6"/><rect x="58" y="40" width="6" height="6"/>
                  <rect x="40" y="40" width="6" height="6"/><rect x="48" y="48" width="6" height="6"/>
                  <rect x="40" y="58" width="6" height="6"/><rect x="70" y="58" width="6" height="6"/>
                  <rect x="82" y="70" width="6" height="6"/><rect x="70" y="82" width="6" height="6"/>
                  <rect x="58" y="70" width="6" height="6"/><rect x="82" y="58" width="6" height="6"/>
                </g>
              </svg>
            </div>
            <div class="mt-5 flex items-center justify-between">
              <div>
                <p class="text-xs text-slate-400">Campaign</p>
                <p class="font-semibold text-white">Downtown Flyers</p>
              </div>
              <span class="flex items-center gap-1.5 text-brand-300 text-sm font-semibold">
                <i data-lucide="trending-up" class="w-4 h-4"></i> 248
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Generator -->
  <section id="generate" class="max-w-6xl mx-auto px-5 sm:px-6 py-8">
    <div class="rounded-3xl bg-[#131316] ring-1 ring-white/10 shadow-card overflow-hidden">
      <div class="grid md:grid-cols-5">
        <div class="md:col-span-3 p-7 sm:p-10">
          <% if (user) { %>
          <h2 class="text-2xl font-bold text-white">Generate a new QR code</h2>
          <p class="mt-2 text-slate-400">Give it a name you'll recognise and the link people should land on.</p>
          <form action="/generate" method="POST" class="mt-7 space-y-5">
            <div>
              <label for="campaign" class="block mb-2 text-sm font-medium text-slate-300">Campaign name or location</label>
              <div class="relative">
                <i data-lucide="tag" class="w-5 h-5 text-slate-500 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                <input id="campaign" name="campaign" type="text" required maxlength="80"
                  placeholder="e.g. Downtown Flyers"
                  class="w-full pl-11 pr-4 py-3 rounded-xl bg-[#0f0f11] text-white placeholder-slate-500 ring-1 ring-white/10 focus:ring-2 focus:ring-brand-400 outline-none transition" />
              </div>
            </div>
            <div>
              <label for="redirect" class="block mb-2 text-sm font-medium text-slate-300">Target URL</label>
              <div class="relative">
                <i data-lucide="link" class="w-5 h-5 text-slate-500 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                <input id="redirect" name="redirect" type="text" required
                  placeholder="yourwebsite.com/landing"
                  class="w-full pl-11 pr-4 py-3 rounded-xl bg-[#0f0f11] text-white placeholder-slate-500 ring-1 ring-white/10 focus:ring-2 focus:ring-brand-400 outline-none transition" />
              </div>
              <p class="mt-1.5 text-xs text-slate-500">We'll add <code class="text-brand-300">https://</code> for you if you forget it.</p>
            </div>
            <button type="submit"
              class="w-full inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl font-semibold text-[#0a0a0a] bg-brand-400 hover:bg-brand-300 shadow-glow transition">
              <i data-lucide="sparkles" class="w-5 h-5"></i> Generate QR code
            </button>
          </form>
          <% } else { %>
          <span class="grid place-items-center w-12 h-12 rounded-xl bg-brand-500/15 ring-1 ring-brand-500/30 text-brand-400 mb-5"><i data-lucide="lock" class="w-6 h-6"></i></span>
          <h2 class="text-2xl font-bold text-white">Create a free account to start generating</h2>
          <p class="mt-2 text-slate-400">Sign up to create trackable QR codes and see every scan on your own private dashboard.</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="/register" class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl font-semibold text-[#0a0a0a] bg-brand-400 hover:bg-brand-300 shadow-glow transition">
              <i data-lucide="user-plus" class="w-5 h-5"></i> Sign up free
            </a>
            <a href="/login" class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl font-semibold text-slate-200 bg-[#131316] ring-1 ring-white/10 hover:bg-[#1c1c20] transition">
              <i data-lucide="log-in" class="w-5 h-5"></i> Log in
            </a>
          </div>
          <% } %>
        </div>
        <aside class="md:col-span-2 bg-gradient-to-br from-brand-500/10 to-transparent border-t md:border-t-0 md:border-l border-white/10 p-7 sm:p-10">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-brand-300">How it works</h3>
          <ol class="mt-5 space-y-5">
            <% const steps = [
              ['pen-line','Name it','Label the code by location or campaign so you can tell scans apart.'],
              ['printer','Print & place it','Download the PNG and stick it on flyers, posters, or packaging.'],
              ['radar','Watch it live','Every scan shows up on your dashboard with city, device and time.']
            ]; %>
            <% steps.forEach(function(s, i){ %>
            <li class="flex gap-4">
              <span class="shrink-0 grid place-items-center w-9 h-9 rounded-xl bg-brand-500/15 ring-1 ring-brand-500/30 text-brand-300 font-bold text-sm"><%= i+1 %></span>
              <div>
                <p class="font-semibold text-white flex items-center gap-2"><i data-lucide="<%= s[0] %>" class="w-4 h-4 text-brand-400"></i> <%= s[1] %></p>
                <p class="text-sm text-slate-400 mt-0.5"><%- s[2] %></p>
              </div>
            </li>
            <% }); %>
          </ol>
        </aside>
      </div>
    </div>
  </section>

  <!-- Recent campaigns -->
  <% if (recent && recent.length) { %>
  <section class="max-w-6xl mx-auto px-5 sm:px-6 py-8">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-lg font-bold text-white">Recent campaigns</h2>
      <a href="/dashboard" class="text-sm text-brand-300 hover:text-brand-200 flex items-center gap-1">All campaigns <i data-lucide="arrow-right" class="w-4 h-4"></i></a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <% recent.forEach(function(c){ %>
      <a href="/c/<%= c.slug %>" class="group rounded-2xl bg-[#131316] ring-1 ring-white/10 p-5 hover:ring-brand-400/40 hover:bg-[#1c1c20] transition">
        <div class="flex items-center justify-between">
          <span class="grid place-items-center w-9 h-9 rounded-lg bg-brand-500/15 text-brand-400"><i data-lucide="qr-code" class="w-4.5 h-4.5"></i></span>
          <i data-lucide="arrow-up-right" class="w-4 h-4 text-slate-600 group-hover:text-brand-400 transition"></i>
        </div>
        <p class="mt-3 font-semibold text-white truncate"><%= c.name %></p>
        <p class="text-xs text-slate-500 truncate mt-0.5"><%= c.targetUrl %></p>
      </a>
      <% }); %>
    </div>
  </section>
  <% } %>
</main>

<%- include('partials/footer') %>
</body>
</html>
