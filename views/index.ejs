<%- include('partials/head', { title: 'Trackable QR codes' }) %>
<%- include('partials/nav') %>

<main>
  <!-- Hero -->
  <section>
    <div class="max-w-6xl mx-auto px-5 sm:px-6 pt-16 pb-12 sm:pt-24 sm:pb-16 grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <h1 class="text-4xl sm:text-6xl font-bold tracking-tight leading-[1.05] text-white">
          See which of your printed QR codes get scanned.
        </h1>
        <p class="mt-6 text-lg text-slate-400 max-w-xl">
          Make a QR code and put it on a flyer, a poster or a box. Each scan is logged with
          the time, the device and an approximate location, and you read them on your dashboard.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <% if (user) { %>
          <a href="#generate" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-semibold text-[#0a0a0a] bg-brand-400 hover:bg-brand-300 transition">
            <i data-lucide="qr-code" class="w-5 h-5"></i> Generate a code
          </a>
          <a href="/dashboard" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-semibold text-slate-200 bg-[#131316] ring-1 ring-white/10 hover:bg-[#1c1c20] transition">
            View dashboard
          </a>
          <% } else { %>
          <a href="/register" class="inline-flex items-center px-5 py-3 rounded-xl font-semibold text-[#0a0a0a] bg-brand-400 hover:bg-brand-300 transition">
            Sign up free
          </a>
          <% } %>
        </div>
        <p class="mt-6 text-sm text-slate-500">People scan with their phone camera. There is nothing for them to install.</p>
      </div>

      <!-- Real QR + sample scan log -->
      <div class="w-full max-w-sm lg:justify-self-end">
        <div class="rounded-2xl bg-[#131316] ring-1 ring-white/10 p-5">
          <div class="flex items-center gap-4">
            <div class="qr-frame w-24 shrink-0"><img src="<%= heroQrSrc %>" alt="A QR code that opens ZipLock" /></div>
            <p class="text-sm text-slate-400">This code is real. Point your phone camera at it and it opens ZipLock.</p>
          </div>
          <div class="mt-5 pt-4 border-t border-white/10">
            <div class="flex items-center justify-between text-xs text-slate-500">
              <span>Sample scan log</span>
              <span>Sample data</span>
            </div>
            <ul class="mt-3 space-y-2 font-mono text-xs text-slate-300">
              <li class="grid grid-cols-[3rem_1fr_auto] gap-x-3"><span class="text-slate-500">09:41</span><span class="truncate">Lisbon, Portugal</span><span class="text-slate-400">Safari</span></li>
              <li class="grid grid-cols-[3rem_1fr_auto] gap-x-3"><span class="text-slate-500">09:38</span><span class="truncate">Austin, USA</span><span class="text-slate-400">Chrome</span></li>
              <li class="grid grid-cols-[3rem_1fr_auto] gap-x-3"><span class="text-slate-500">09:12</span><span class="truncate text-slate-500">Location unknown</span><span class="text-slate-400">Chrome</span></li>
            </ul>
            <p class="mt-3 text-xs text-slate-500">Your own scans appear here. Some networks can't be placed, so a few rows will say unknown.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Generator for signed-in users, explainer for visitors -->
  <section id="generate" class="max-w-6xl mx-auto px-5 sm:px-6 py-8">
    <div class="rounded-3xl bg-[#131316] ring-1 ring-white/10 overflow-hidden">
      <div class="grid md:grid-cols-5">
        <div class="md:col-span-3 p-7 sm:p-10">
          <% if (user) { %>
          <h2 class="text-2xl font-bold text-white">Generate a new QR code</h2>
          <p class="mt-2 text-slate-400">Give it a name you'll recognise and the link people should land on.</p>
          <form action="/generate" method="POST" class="mt-7 space-y-5">
            <div>
              <label for="campaign" class="block mb-2 text-sm font-medium text-slate-300">Campaign name or location</label>
              <input id="campaign" name="campaign" type="text" required maxlength="80"
                placeholder="e.g. Downtown Flyers"
                class="w-full px-4 py-3 rounded-xl bg-[#0f0f11] text-white placeholder-slate-500 ring-1 ring-white/10 focus:ring-2 focus:ring-brand-400 outline-none transition" />
            </div>
            <div>
              <label for="redirect" class="block mb-2 text-sm font-medium text-slate-300">Target URL</label>
              <input id="redirect" name="redirect" type="text" required
                placeholder="yourwebsite.com/landing"
                class="w-full px-4 py-3 rounded-xl bg-[#0f0f11] text-white placeholder-slate-500 ring-1 ring-white/10 focus:ring-2 focus:ring-brand-400 outline-none transition" />
              <p class="mt-1.5 text-xs text-slate-500">We'll add <code class="font-mono text-slate-300">https://</code> for you if you forget it.</p>
            </div>
            <button type="submit"
              class="w-full inline-flex items-center justify-center px-5 py-3.5 rounded-xl font-semibold text-[#0a0a0a] bg-brand-400 hover:bg-brand-300 transition">
              Generate QR code
            </button>
          </form>
          <% } else { %>
          <h2 class="text-2xl font-bold text-white">How it works</h2>
          <div class="mt-7"><%- include('partials/steps') %></div>
          <% } %>
        </div>
        <aside class="md:col-span-2 bg-[#0f0f11] border-t md:border-t-0 md:border-l border-white/10 p-7 sm:p-10">
          <% if (user) { %>
          <h3 class="text-sm font-semibold text-slate-400">How it works</h3>
          <div class="mt-5"><%- include('partials/steps') %></div>
          <% } else { %>
          <h3 class="text-sm font-semibold text-slate-400">What each scan records</h3>
          <ul class="mt-5 space-y-4 text-sm">
            <li>
              <p class="font-semibold text-white">When</p>
              <p class="mt-0.5 text-slate-400">The date and time of the scan.</p>
            </li>
            <li>
              <p class="font-semibold text-white">What it was scanned on</p>
              <p class="mt-0.5 text-slate-400">Device type, browser and operating system.</p>
            </li>
            <li>
              <p class="font-semibold text-white">Roughly where</p>
              <p class="mt-0.5 text-slate-400">A city when the IP address can be placed, otherwise a country, otherwise nothing. Mobile networks are the hardest to place.</p>
            </li>
          </ul>
          <p class="mt-5 text-xs text-slate-500">The IP address is stored with each scan so the location can be worked out. The person scanning isn't asked for anything.</p>
          <% } %>
        </aside>
      </div>
    </div>
  </section>

  <%# Recent campaigns: only fetched and rendered for the signed-in user's own campaigns %>
  <% if (recent && recent.length) { %>
  <section class="max-w-6xl mx-auto px-5 sm:px-6 py-8">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-lg font-bold text-white">Recent campaigns</h2>
      <a href="/dashboard" class="text-sm text-slate-300 hover:text-white flex items-center gap-1 py-2">All campaigns <i data-lucide="arrow-right" class="w-4 h-4"></i></a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <% recent.forEach(function(c){ %>
      <a href="/c/<%= c.slug %>" class="group rounded-2xl bg-[#131316] ring-1 ring-white/10 p-5 hover:ring-white/25 hover:bg-[#1c1c20] transition">
        <div class="flex items-start justify-between gap-3">
          <p class="font-semibold text-white truncate"><%= c.name %></p>
          <i data-lucide="arrow-up-right" class="w-4 h-4 shrink-0 text-slate-600 group-hover:text-white transition"></i>
        </div>
        <p class="text-xs text-slate-500 truncate mt-1"><%= c.targetUrl %></p>
      </a>
      <% }); %>
    </div>
  </section>
  <% } %>
</main>

<%- include('partials/footer') %>
</body>
</html>
