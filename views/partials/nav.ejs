  <header class="sticky top-0 z-40 backdrop-blur-xl bg-[#0a0a0a]/70 border-b border-white/10">
    <nav class="max-w-6xl mx-auto px-5 sm:px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5 group">
        <span class="grid place-items-center w-9 h-9 rounded-xl bg-brand-500/15 ring-1 ring-brand-500/30 text-brand-400 group-hover:bg-brand-500/25 transition">
          <i data-lucide="qr-code" class="w-5 h-5"></i>
        </span>
        <span class="text-lg font-bold tracking-tight text-white">Zip<span class="text-brand-400">Lock</span></span>
      </a>

      <!-- Desktop nav -->
      <div class="hidden sm:flex items-center gap-1 sm:gap-2 text-sm">
        <a href="/" class="px-3 py-2 rounded-lg font-medium <%= page === 'home' ? 'text-white bg-white/5' : 'text-slate-400 hover:text-white hover:bg-white/5' %> transition">Generate</a>
        <% if (user) { %>
          <a href="/dashboard" class="px-3 py-2 rounded-lg font-medium <%= page === 'dashboard' ? 'text-white bg-white/5' : 'text-slate-400 hover:text-white hover:bg-white/5' %> transition">Dashboard</a>
          <span class="inline-block w-px h-5 bg-white/10 mx-1"></span>
          <span class="text-slate-400 px-1">Hi, <%= user.name %></span>
          <a href="/logout" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg font-semibold text-slate-200 bg-[#131316] hover:bg-[#1c1c20] ring-1 ring-white/10 transition">
            <i data-lucide="log-out" class="w-4 h-4"></i> Log out
          </a>
        <% } else { %>
          <a href="/login" class="px-3 py-2 rounded-lg font-medium <%= page === 'login' ? 'text-white bg-white/5' : 'text-slate-400 hover:text-white hover:bg-white/5' %> transition">Log in</a>
          <a href="/register" class="inline-flex items-center gap-1.5 ml-1 px-3.5 py-2 rounded-lg font-semibold text-[#0a0a0a] bg-brand-400 hover:bg-brand-300 shadow-glow transition">
            <i data-lucide="sparkles" class="w-4 h-4"></i> Sign up free
          </a>
        <% } %>
      </div>

      <!-- Mobile toggle -->
      <button id="nav-toggle" type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-panel"
        class="sm:hidden grid place-items-center w-10 h-10 rounded-lg bg-white/5 hover:bg-white/10 text-slate-200 transition">
        <i data-lucide="menu" class="w-5 h-5" id="nav-icon-menu"></i>
        <i data-lucide="x" class="w-5 h-5 hidden" id="nav-icon-close"></i>
      </button>
    </nav>

    <!-- Mobile collapsible panel -->
    <div id="nav-panel" class="hidden sm:hidden border-t border-white/10 bg-[#0a0a0a]/95">
      <div class="max-w-6xl mx-auto px-5 py-3 flex flex-col gap-1 text-sm">
        <a href="/" class="px-3 py-2.5 rounded-lg font-medium <%= page === 'home' ? 'text-white bg-white/5' : 'text-slate-400 hover:text-white hover:bg-white/5' %> transition">Generate</a>
        <% if (user) { %>
          <a href="/dashboard" class="px-3 py-2.5 rounded-lg font-medium <%= page === 'dashboard' ? 'text-white bg-white/5' : 'text-slate-400 hover:text-white hover:bg-white/5' %> transition">Dashboard</a>
          <div class="border-t border-white/10 my-1"></div>
          <span class="px-3 py-1 text-xs text-slate-500">Signed in as <%= user.name %></span>
          <a href="/logout" class="flex items-center gap-2 px-3 py-2.5 rounded-lg font-semibold text-slate-200 bg-[#131316] hover:bg-[#1c1c20] ring-1 ring-white/10 transition">
            <i data-lucide="log-out" class="w-4 h-4"></i> Log out
          </a>
        <% } else { %>
          <a href="/login" class="px-3 py-2.5 rounded-lg font-medium <%= page === 'login' ? 'text-white bg-white/5' : 'text-slate-400 hover:text-white hover:bg-white/5' %> transition">Log in</a>
          <a href="/register" class="flex items-center gap-2 px-3 py-2.5 rounded-lg font-semibold text-[#0a0a0a] bg-brand-400 hover:bg-brand-300 shadow-glow transition">
            <i data-lucide="sparkles" class="w-4 h-4"></i> Sign up free
          </a>
        <% } %>
      </div>
    </div>
  </header>

  <script>
    (function () {
      var btn = document.getElementById('nav-toggle');
      var panel = document.getElementById('nav-panel');
      if (!btn || !panel) return;
      // Query the icons fresh each time rather than caching them: lucide.createIcons()
      // (called later, in the footer) replaces the <i data-lucide> elements with new
      // <svg> nodes instead of mutating them in place, which would orphan a cached reference.
      function setOpen(open) {
        panel.classList.toggle('hidden', !open);
        var iconMenu = document.getElementById('nav-icon-menu');
        var iconClose = document.getElementById('nav-icon-close');
        if (iconMenu) iconMenu.classList.toggle('hidden', open);
        if (iconClose) iconClose.classList.toggle('hidden', !open);
        btn.setAttribute('aria-expanded', String(open));
      }
      btn.addEventListener('click', function () {
        setOpen(panel.classList.contains('hidden'));
      });
      // Close the panel whenever a nav link inside it is followed.
      panel.querySelectorAll('a').forEach(function (link) {
        link.addEventListener('click', function () { setOpen(false); });
      });
    })();
  </script>
