<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : brand %> · ZipLock</title>
  <meta name="description" content="ZipLock makes QR codes you can track. Each scan is logged with its time, device and approximate location." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Archivo', 'system-ui', '-apple-system', 'sans-serif'],
            mono: ['IBM Plex Mono', 'ui-monospace', 'SFMono-Regular', 'monospace']
          },
          colors: {
            brand: {
              50:'#fbffee',100:'#f5ffd6',200:'#eeffb0',300:'#dfff7a',400:'#cfff3e',
              500:'#a8db1e',600:'#84ad14',700:'#63820f',800:'#4b620e',900:'#3d4f11',950:'#212b06'
            }
          },
          boxShadow: {
            card: '0 10px 40px -12px rgba(0,0,0,0.5)'
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="/css/app.css" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  
  <!-- Vercel Web Analytics -->
  <script>
    window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
  </script>
  <script defer src="/_vercel/insights/script.js"></script>
</head>
<body class="min-h-screen bg-[#0a0a0a] text-slate-200 font-sans antialiased selection:bg-brand-500/30">
