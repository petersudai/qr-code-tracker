<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : brand %> · ZipLock</title>
  <meta name="description" content="ZipLock — generate trackable QR codes and see exactly where, when and on what device they get scanned." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'] },
          colors: {
            brand: {
              50:'#ecfdf5',100:'#d1fae5',200:'#a7f3d0',300:'#6ee7b7',400:'#34d399',
              500:'#10b981',600:'#059669',700:'#047857',800:'#065f46',900:'#064e3b',950:'#022c22'
            }
          },
          boxShadow: {
            glow: '0 0 50px -12px rgba(16,185,129,0.55)',
            card: '0 10px 40px -12px rgba(0,0,0,0.5)'
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="/css/app.css" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body class="min-h-screen bg-[#070b14] text-slate-200 font-sans antialiased selection:bg-brand-500/30">
  <div class="bg-aura"></div>
