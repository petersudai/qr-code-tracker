<div class="rounded-2xl bg-white/5 ring-1 ring-white/10 p-5 sm:p-6">
  <h2 class="font-semibold text-white flex items-center gap-2 mb-4">
    <i data-lucide="<%= icon %>" class="w-4 h-4 text-brand-400"></i> <%= title %>
  </h2>
  <% if (!rows || !rows.length) { %>
    <p class="text-sm text-slate-500 py-4">No data yet.</p>
  <% } else { %>
    <ul class="space-y-3">
      <% rows.forEach(function(r){ var pct = total ? Math.round(r.count/total*100) : 0; %>
      <li>
        <div class="flex items-center justify-between text-sm mb-1.5">
          <span class="text-slate-300 capitalize truncate pr-2"><%= r.label %></span>
          <span class="text-slate-400 tabular-nums shrink-0"><%= r.count %> · <%= pct %>%</span>
        </div>
        <div class="h-1.5 rounded-full bg-white/5 overflow-hidden">
          <div class="h-full rounded-full bg-brand-400" style="width: <%= pct %>%"></div>
        </div>
      </li>
      <% }); %>
    </ul>
  <% } %>
</div>
