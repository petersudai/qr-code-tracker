<%# A hung banner with a scannable code. Local: p %>
<div class="relative">
  <span aria-hidden="true" class="absolute top-2 left-2 z-10 w-2.5 h-2.5 rounded-full bg-black/40 ring-2 ring-white/60"></span>
  <span aria-hidden="true" class="absolute top-2 right-2 z-10 w-2.5 h-2.5 rounded-full bg-black/40 ring-2 ring-white/60"></span>
  <div class="rounded-xl overflow-hidden flex flex-col md:flex-row shadow-[0_14px_32px_-10px_rgba(0,0,0,0.8)]" style="background: <%= p.bg %>; color: <%= p.fg %>">
    <div class="flex-1 p-6 sm:p-8">
      <p class="text-sm font-bold"><%= p.brand %> <span class="font-medium">· <%= p.tagline %></span></p>
      <p class="mt-3 text-3xl sm:text-5xl font-bold leading-[1.02]"><%= p.title %></p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <span class="inline-block rounded-xl px-3 py-2 text-sm font-bold" style="background: <%= p.accent %>; color: <%= p.accentFg %>"><%= p.offer %></span>
        <span class="text-sm font-medium"><%= p.hours %></span>
      </div>
    </div>
    <div class="hidden md:block w-52 p-6 self-center"><%- include('poster-art', { art: p.art, accent: p.accent, fg: p.fg, bg: p.bg }) %></div>
    <div class="p-6 sm:p-8 flex flex-row md:flex-col items-center justify-center gap-4 md:w-56" style="background: <%= p.brandBg %>; color: <%= p.brandFg %>">
      <p class="text-sm font-bold md:text-center"><%= p.cta %></p>
      <div class="qr-frame w-24 md:w-28 shrink-0"><img src="<%= p.qr %>" alt="QR code on the <%= p.alt %>" /></div>
    </div>
  </div>
</div>
